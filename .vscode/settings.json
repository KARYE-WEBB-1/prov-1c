{
    "workbench.iconTheme": "vscode-great-icons",
    "git.openRepositoryInParentFolders": "always",
    "workbench.colorCustomizations": {
        "activityBar.background": "#594905",
        "titleBar.activeBackground": "#EBBF0E",
        "titleBar.activeForeground": "#1F1902",
        "titleBar.inactiveBackground": "#594905",
        "titleBar.inactiveForeground": "#1F1902",
        "statusBar.background": "#6D5806",
        "statusBar.foreground": "#FEFBEE",
        "statusBar.debuggingBackground": "#6D5806",
        "statusBar.debuggingForeground": "#FEFBEE",
        "statusBar.noFolderBackground": "#6D5806",
        "statusBar.noFolderForeground": "#FEFBEE"
    },
    "editor.codeLens": false,
    "editor.multiCursorModifier": "ctrlCmd",
    "files.autoSave": "afterDelay",
    "git.postCommitCommand": "sync",
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": "active",
    "sessionlogger.enabled": false,
    "explorer.compactFolders": false,
    "explorer.sortOrderLexicographicOptions": "unicode",
    "chat.commandCenter.enabled": false,
    "chat.disableAIFeatures": true,
    "workbench.experimental.modernUI": false
}